# Reference checkouts are large and reproducible from ref/README.md.
# Keep the index, Markdown notes, CLI snapshot and probe scripts; ignore
# cloned repositories, raw HTML/JSON snapshots, and local probe logs.
/ref/*
!/ref/README.md
!/ref/notes/
/ref/notes/*
!/ref/notes/*.md
!/ref/notes/*.txt
!/ref/notes/probe-*.mjs
